# Create .gitignore
cat > .gitignore << 'EOF'
# Virtual environments
llm_env/
venv/
env/
.venv/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
build/
dist/

# Node
node_modules/

# Environment variables
.env
.env.*

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Binary/model/library files
*.so
*.dll
*.exe
*.o
*.obj
*.out
*.a

# Archives
*.zip
*.tar
*.gz
*.rar
*.7z

# Database
*.db
*.sqlite

# ML model files
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
EOF